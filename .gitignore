# Compiled python modules.
*.pyc
__pycache__/

# Setuptools distribution folder.
/dist/

# Python egg metadata, regenerated from source files by setuptools.
/*.egg-info

*.DS_Store
.vscode
.ipynb_checkpoints
# Root-level generated figures only. NOT a bare `figures` pattern: that also excluded
# sub_sampled_fielder_vec/docs/overleafs/v9/figures/, which kept the whole paper out of
# git, and a `!` negation underneath cannot re-include files inside an excluded directory.
/figures/
matlab_tests
docs/_build
data
experiments/log/*
experiments/results/*
tests/RAxML_bestTree.dendropy_raxml
tests/RAxML_info.dendropy_raxml
tests/RAxML_log.dendropy_raxml
tests/RAxML_parsimonyTree.dendropy_raxml
tests/RAxML_result.dendropy_raxml

# Sub-sampled STDR experimental results and generated data
sub_sampled_fielder_vec/results/
sub_sampled_fielder_vec/**/*.png
# ...except the paper's own figures, which are a tracked deliverable.
# Both patterns are needed: the second covers figures/Fiedler_Bipartitions/.
!sub_sampled_fielder_vec/docs/overleafs/v9/figures/*.png
!sub_sampled_fielder_vec/docs/overleafs/v9/figures/**/*.png
# Same for the distance-route note, which carries its own figures/ dir.
!sub_sampled_fielder_vec/docs/overleafs/v9/distance-route-2/figures/*.png
# Notebook scratch figure dir (v8-era leftovers; see analysis/README.md).
# Both paths listed while the theoretical_interpretation/ layer is being collapsed;
# the second line goes away once the move lands.
sub_sampled_fielder_vec/analysis/figures/
sub_sampled_fielder_vec/analysis/theoretical_interpretation/figures/
sub_sampled_fielder_vec/.claude/

# Superseded manuscript versions — only v9 is tracked.
sub_sampled_fielder_vec/docs/overleafs/v7/
sub_sampled_fielder_vec/docs/overleafs/v8/
sub_sampled_fielder_vec/docs/overleafs/distance approach/
sub_sampled_fielder_vec/docs/overleafs/Fiedler_Bipartitions/

# Third-party reference PDFs and scratch assets under docs/.
# A `git add -A` swept 10.9 MB of these into commit b53e2f5; they are reference
# material, not project source. Two files predate that and stay tracked:
# docs/papers/README.md and Spectral_top-down_recovery_of_latent_tree_models.pdf.
sub_sampled_fielder_vec/docs/papers/*.pdf
!sub_sampled_fielder_vec/docs/papers/Spectral_top-down_recovery_of_latent_tree_models.pdf
sub_sampled_fielder_vec/docs/papers/Matrix Completion from a Few Entries copy
sub_sampled_fielder_vec/docs/*.jpg
# Byte-identical duplicate of the gitignored docs/overleafs/distance approach/distance_version.tex
sub_sampled_fielder_vec/docs/distance_extension.live.main.tex
# Superseded draft of the tracked thesis_seminar.html
sub_sampled_fielder_vec/docs/thesis_seminar - paper order.html

# Machine state and run artifacts — never source.
# 35 logs were tracked, none referenced by anything, all containing absolute
# /Users/... paths. last_run.json is mutable state written by interactive_run.py,
# so tracking it dirtied the tree on every run.
sub_sampled_fielder_vec/logs/
sub_sampled_fielder_vec/last_run.json

# Personal IDE configuration
WARP.md
.claude/

# Virtual environments
venv/
env/
.venv/

# Theoretical-interpretation cache (regenerable, large)
sub_sampled_fielder_vec/cache/

# Test and demo files (local development)
*.ipynb
# The paper's notebooks are tracked. This negation MUST stay in step with their
# location: it is path-specific, so moving them anywhere it does not cover makes
# all 16 silently vanish from git (they fall back to the bare `*.ipynb` above).
!sub_sampled_fielder_vec/analysis/**/*.ipynb
test*.py
# ...but sub_sampled_fielder_vec/tests/ must be committable. The bare `test*.py` above is
# why that directory has never held a single test.
!sub_sampled_fielder_vec/tests/test_*.py
comparing.py
requirements.txt
eigenvalue*.png
eigenvector*.png
second_vs_third_eigenvector.png
spectraltree/my_similarity.py
