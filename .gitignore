# Compiled python modules.
*.pyc
__pycache__/

# Setuptools distribution folder.
/dist/

# Python egg metadata, regenerated from source files by setuptools.
/*.egg-info

*.DS_Store
.vscode
.ipynb_checkpoints
# Root-level generated figures only. NOT a bare `figures` pattern: that also excluded
# sub_sampled_fielder_vec/docs/overleafs/v9/figures/, which kept the whole paper out of
# git, and a `!` negation underneath cannot re-include files inside an excluded directory.
/figures/
matlab_tests
docs/_build
data
experiments/log/*
experiments/results/*
tests/RAxML_bestTree.dendropy_raxml
tests/RAxML_info.dendropy_raxml
tests/RAxML_log.dendropy_raxml
tests/RAxML_parsimonyTree.dendropy_raxml
tests/RAxML_result.dendropy_raxml

# Sub-sampled STDR experimental results and generated data
sub_sampled_fielder_vec/results/
sub_sampled_fielder_vec/**/*.png
# ...except the paper's own figures, which are a tracked deliverable.
# Both patterns are needed: the second covers figures/Fiedler_Bipartitions/.
!sub_sampled_fielder_vec/docs/overleafs/v9/figures/*.png
!sub_sampled_fielder_vec/docs/overleafs/v9/figures/**/*.png
# Notebook scratch figure dir (v8-era leftovers; see analysis/theoretical_interpretation/README.md)
sub_sampled_fielder_vec/analysis/theoretical_interpretation/figures/
sub_sampled_fielder_vec/.claude/
sub_sampled_fielder_vec/src/cache/

# Superseded manuscript versions — only v9 is tracked.
sub_sampled_fielder_vec/docs/overleafs/v7/
sub_sampled_fielder_vec/docs/overleafs/v8/
sub_sampled_fielder_vec/docs/overleafs/distance approach/
sub_sampled_fielder_vec/docs/overleafs/Fiedler_Bipartitions/

# Personal IDE configuration
WARP.md
.claude/

# Virtual environments
venv/
env/
.venv/

# Theoretical-interpretation cache (regenerable, large)
sub_sampled_fielder_vec/cache/

# Test and demo files (local development)
*.ipynb
!sub_sampled_fielder_vec/analysis/theoretical_interpretation/**/*.ipynb
test*.py
# ...but sub_sampled_fielder_vec/tests/ must be committable. The bare `test*.py` above is
# why that directory has never held a single test.
!sub_sampled_fielder_vec/tests/test_*.py
comparing.py
requirements.txt
eigenvalue*.png
eigenvector*.png
second_vs_third_eigenvector.png
spectraltree/my_similarity.py
